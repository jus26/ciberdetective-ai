# GEMINI_API_KEY: Clave de API de Google Gemini (uso exclusivo en el servidor).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MONGODB_URI: Cadena de conexión a MongoDB Atlas (ej. mongodb+srv://usuario:clave@cluster.mongodb.net/ciberdetective).
# Si se omite en entorno local de pruebas, el servidor utiliza persistencia JSON local automática.
MONGODB_URI=""

# JWT_SECRET: Secreto criptográfico largo para firmar tokens JWT de sesión.
JWT_SECRET="CAMBIA_ESTE_SECRETO_EN_PRODUCCION_MINIMO_32_CARACTERES"

# PORT & APP_URL: Puerto del servidor Express y URL pública en producción (Render).
PORT=3000
APP_URL="http://localhost:3000"
NODE_ENV="development"
