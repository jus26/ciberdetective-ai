# Puerto del servidor Express
PORT=4000
NODE_ENV=development

# Cadena de conexión a MongoDB Atlas
MONGODB_URI="mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/ciberdetective_ai?retryWrites=true&w=majority"

# Secreto para firmar tokens JWT (mínimo 32 caracteres aleatorios)
JWT_SECRET="REEMPLAZA_CON_UN_SECRETO_LARGO_Y_ALEATORIO"
JWT_EXPIRES_IN="7d"

# Clave de Google Gemini API (uso exclusivo en backend)
GEMINI_API_KEY="TU_GEMINI_API_KEY"

# Origen permitido por CORS (URL del cliente React)
CORS_ORIGIN="http://localhost:5173"
